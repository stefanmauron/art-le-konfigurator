{
  "name": "utg-le-configurator",
  "version": "3.16.0-rc.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node tests/verify-build.mjs",
    "test": "node tests/run-regressions.cjs",
    "format": "prettier --write \"src/**/*.js\" \"src/styles/*.css\" \"scripts/*.mjs\" \"tests/*.mjs\" \"tests/*.cjs\"",
    "test:browser": "node tests/browser-parity.cjs",
    "test:flow": "node tests/run-browser-family.cjs control",
    "test:edges": "node tests/run-browser-family.cjs edges",
    "test:roundtrip": "node tests/roundtrip.cjs",
    "test:performance": "node tests/performance.cjs",
    "lint": "eslint src",
    "test:assessments": "node tests/assessments-and-agreements.cjs",
    "test:release": "node tests/release-smoke.cjs",
    "test:compare-versions": "node tests/compare-user-versions.cjs",
    "build:merge": "node merge-tool/build.mjs",
    "test:merge": "node merge-tool/test.mjs",
    "test:activities": "node tests/activity-order.cjs",
    "test:flow-basic": "node tests/run-browser-family.cjs flow",
    "test:all": "node tests/run-all.cjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
